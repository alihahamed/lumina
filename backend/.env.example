# Copy to backend/.env (gitignored) and fill in. Never commit the real file.

# From https://aistudio.google.com/apikey — free tier is enough for this project.
GEMINI_API_KEY=

# Optional. Default gemini-3.1-flash-lite, fallback gemini-3.5-flash-lite (docs/decisions.md).
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODEL=

# Required when deployed: only signed-in Lumina users (Supabase tokens) may call /describe.
# Leave unset for local development to skip the check.
# SUPABASE_URL=https://<project>.supabase.co
