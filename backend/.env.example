# Copy to backend/.env (gitignored) and fill in. Never commit the real file.

# From https://aistudio.google.com/apikey — free tier is enough for this project.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=

# Optional shared secret. If set, the app must send the same value
# (EXPO_PUBLIC_LUMINA_TOKEN in the root .env). Set it before deploying anywhere public.
# LUMINA_APP_TOKEN=
