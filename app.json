{
  "expo": {
    "name": "Lumina",
    "slug": "lumina",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "plugins": [
      "expo-dev-client",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lumina listens only while you hold the screen, to hear your command.",
          "speechRecognitionPermission": "Lumina turns your spoken command into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "android": {
      "package": "com.lumina.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.lumina.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Lumina uses the camera to detect obstacles and describe what is around you.",
        "NSMicrophoneUsageDescription": "Lumina may use the microphone for future voice features and AR session audio.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos",
        "NSPhotoLibraryAddUsageDescription": "Allow $(PRODUCT_NAME) to save photos"
      }
    },
    "extra": {
      "eas": {
        "projectId": "41432245-dfdd-45fd-97ff-473578998bd3"
      }
    },
    "owner": "dere.koo"
  }
}
